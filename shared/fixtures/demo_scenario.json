  "procedure": {
    "procedure_id": "PROC-BP-01",
    "version": "1.1.0-demo",
    "title": "Non-invasive upper-arm blood-pressure measurement (educational demonstration)",
    "purpose": "Demonstrates how a non-medical crew member could be guided to take an automatic upper-arm blood-pressure reading for a configured, fictional assessment.",
    "required_capability": "blood_pressure",
    "compatible_device_models": [
      "Demo Automatic Upper-Arm BP Monitor A1"
    ],
    "anatomical_region_ids": [
      "upper_arm"
    ],
    "content_status": "EDUCATIONAL_DEMO_ONLY",
    "source_basis": "Paraphrased from widely published general guidance for automatic home upper-arm blood-pressure measurement (for example American Heart Association home-monitoring guidance). Not reviewed by a flight surgeon and not a mission-approved procedure.",
    "safety_limitations": [
      "Educational demonstration only. Not a clinically validated or mission-approved procedure.",
      "Do not use this procedure to diagnose or treat any condition.",
      "Stop if the cuff causes pain, numbness or tingling, and release the cuff.",
      "If you feel chest pain, severe headache, faintness or shortness of breath, stop and activate the emergency workflow or call a crew member.",
      "Confirming a step records an acknowledgement only. It does not prove the step was performed correctly."
    ],
    "steps": [
      {
        "step_id": "S1",
        "order": 1,
        "title": "Prepare and rest",
        "instruction": "Restrain yourself in a relaxed, supported position. Rest quietly for 5 minutes. Avoid exercise, caffeine and talking during this time.",
        "anatomical_region_ids": [],
        "requires_confirmation": true,
        "responder_note": "Help the crew member into a supported, relaxed position.",
